# ── Core ──────────────────────────────────────────────────────────────────
# Strong random secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────
# Production: PostgreSQL. Local dev can use sqlite:///./contentai.db
DATABASE_URL=postgresql+psycopg2://contentai:contentai@localhost:5432/contentai

# ── Ollama (AI) ───────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ── CORS ──────────────────────────────────────────────────────────────────
# List the public origin(s) of the deployed site, e.g.
# ["https://contentai.example.com"]
CORS_ORIGINS=["http://localhost:8000"]

# ── Public URL ────────────────────────────────────────────────────────────
# Publicly reachable base URL of this site (NO trailing slash). Instagram's
# servers fetch media from here, so it MUST be public HTTPS in production.
# Local dev: http://localhost:8000
PUBLIC_BASE_URL=https://contentai.example.com

# ── Instagram Graph API (real publishing) ─────────────────────────────────
# Facebook App ID / App Secret of the app with the "Instagram Graph API"
# use case enabled. See README "Go live" section.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_API_VERSION=v22.0
INSTAGRAM_SCOPES=instagram_basic,instagram_content_publish,pages_show_list

# ── Social demo mode ──────────────────────────────────────────────────────
# When true (and a platform has no credentials), connect shows a simulated
# demo account. Set to false in production so users always connect real
# accounts and get a clear error if a platform isn't configured.
SOCIAL_DEMO_MODE=false

# ── Scheduler ─────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=60

# ── n8n automation layer (optional) ──────────────────────────────────────
# When enabled, ContentAI notifies the n8n webhook about jobs (content
# generation, scheduled publishing). n8n orchestrates and calls back the
# secured backend endpoint; all tokens/secrets stay inside ContentAI.
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
# Shared secret used to sign requests in BOTH directions (HMAC-SHA256).
N8N_WEBHOOK_SECRET=change-me-to-a-random-secret
